@wtl 1
<Page title={t('system_import')}>
  <Include name="pager_header" props={{ description: t('system_import_description') }} />
  <Form id="upload">
    <Input name="file" type="file" label={t('system_import_file')} required />
    <Button
      action={contract('@1ImportUpload', { Data: upload.file })}
      onSuccess={navigate('import_app')}
      tone="primary"
      icon="upload"
    >
      {t('system_import_upload')}
    </Button>
  </Form>
</Page>
